{
  "openapi": "3.0.3",
  "info": {
    "title": "v-http-apilab",
    "version": "1.0.1",
    "description": "Synthetic and deterministic corporate API for lab use. All data is 100% synthetic and lives in memory: restarting the process restores the initial state. Every response carries the X-Request-ID header (using the received value when valid, or a generated UUID v4). Every error response follows the format {\"error\":{\"code\",\"message\",\"request_id\"}}. The optional X-Test-Case header labels the request in the structured log and in the /lab/calls buffer.",
    "license": { "name": "MIT" }
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Local server (port configurable via the PORT env)" }
  ],
  "tags": [
    { "name": "Infra", "description": "Observability and service metadata" },
    { "name": "Docs", "description": "API documentation" },
    { "name": "Auth", "description": "Simulated authentication (no real security)" },
    { "name": "Users", "description": "CRUD over synthetic users" },
    { "name": "Search", "description": "Search over the synthetic corpus" },
    { "name": "Reports", "description": "Synthetic reports and export" },
    { "name": "Tickets", "description": "Synthetic tickets" },
    { "name": "Forms", "description": "Urlencoded forms" },
    { "name": "Integrations", "description": "Webhooks and the GraphQL stub" },
    { "name": "Files", "description": "In-memory uploads and static files" },
    { "name": "Admin", "description": "Simulated administration" },
    { "name": "Lab", "description": "Testing utilities (echo, status, limits, proof of receipt)" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Infra"],
        "summary": "Service index",
        "responses": {
          "200": { "description": "Basic information and main endpoints", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Index" } } } }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Infra"],
        "summary": "Liveness",
        "responses": {
          "200": { "description": "Server alive", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["Infra"],
        "summary": "Readiness",
        "description": "Answers 503 when the READY_FORCE_FAIL env has any non-empty value.",
        "responses": {
          "200": { "description": "Ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ready" } } } },
          "503": { "description": "Unavailable by configuration (READY_FORCE_FAIL)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ready" } } } }
        }
      }
    },
    "/version": {
      "get": {
        "tags": ["Infra"],
        "summary": "Versions and build",
        "responses": {
          "200": { "description": "App version, V compiler version and build date", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Version" } } } }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Infra"],
        "summary": "Prometheus format metrics",
        "responses": {
          "200": { "description": "Prometheus text (v_http_apilab_up, uptime, requests_total by route/status)", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["Docs"],
        "summary": "OpenAPI specification of this API",
        "responses": {
          "200": { "description": "OpenAPI 3.0.3 document", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": ["Docs"],
        "summary": "Swagger UI",
        "description": "HTML page with Swagger UI pointing at /openapi.json. The UI assets are loaded from a CDN (requires internet access in the browser).",
        "responses": {
          "200": { "description": "Swagger UI page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login with synthetic credentials",
        "description": "Default credentials: admin / lab-password-123456 (configurable via LAB_USERNAME and LAB_PASSWORD). The password is never logged or returned.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Synthetic token issued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revokes the token",
        "parameters": [{ "$ref": "#/components/parameters/BearerAuth" }],
        "responses": {
          "200": { "description": "Token revoked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Logout" } } } },
          "401": { "description": "Missing or unknown token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Synthetic profile of the token",
        "parameters": [{ "$ref": "#/components/parameters/BearerAuth" }],
        "responses": {
          "200": { "description": "Synthetic profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } } },
          "401": { "description": "Missing, invalid or expired token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Lists users with pagination",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 }, "description": "Page (default 1)" },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }, "description": "Items per page (1..100)" },
          { "name": "department", "in": "query", "schema": { "type": "string" }, "description": "Exact department filter" }
        ],
        "responses": {
          "200": { "description": "Page of users", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsersPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Creates a user",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } } } },
        "responses": {
          "201": { "description": "User created (ids start at 26)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/UserId" }],
      "get": {
        "tags": ["Users"],
        "summary": "Fetches a user",
        "responses": {
          "200": { "description": "User", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Replaces a user",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } } } },
        "responses": {
          "200": { "description": "User updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Partial update",
        "description": "Any subset of name, email, department, role. Unknown fields and non-string values are rejected.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserPatch" } } } },
        "responses": {
          "200": { "description": "User updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Deletes a user",
        "responses": {
          "204": { "description": "Deleted (no body)" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Search over the synthetic corpus",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 256 }, "description": "Search term (substring, case-insensitive)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }, "description": "Maximum number of results" }
        ],
        "responses": {
          "200": { "description": "Results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Search" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/reports": {
      "get": {
        "tags": ["Reports"],
        "summary": "Report catalog",
        "responses": {
          "200": { "description": "6 fixed reports", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportsPage" } } } }
        }
      }
    },
    "/api/v1/reports/export": {
      "post": {
        "tags": ["Reports"],
        "summary": "Requests an export (synthetic job)",
        "description": "Nothing actually runs; the job is listed in /internal/debug.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportRequest" } } } },
        "responses": {
          "202": { "description": "Job accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportJob" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/reports/{id}/download": {
      "get": {
        "tags": ["Reports"],
        "summary": "Downloads the synthetic report CSV",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "report_id (rep-001..rep-006)" }],
        "responses": {
          "200": { "description": "Deterministic synthetic CSV", "content": { "text/csv": { "schema": { "type": "string" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tickets": {
      "post": {
        "tags": ["Tickets"],
        "summary": "Creates a ticket",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketInput" } } } },
        "responses": {
          "201": { "description": "Ticket created (ids start at 4; the seed has 3)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/tickets/{id}": {
      "get": {
        "tags": ["Tickets"],
        "summary": "Fetches a ticket",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "200": { "description": "Ticket", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/forms/feedback": {
      "post": {
        "tags": ["Forms"],
        "summary": "Urlencoded form intake",
        "description": "Content-Type must be application/x-www-form-urlencoded. Values are echoed back with correct JSON escaping.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["rating"],
                "properties": {
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "name": { "type": "string", "maxLength": 100 },
                  "comment": { "type": "string", "maxLength": 500 },
                  "email": { "type": "string", "maxLength": 254 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Confirmation echoing the fields", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Feedback" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/webhooks/receive": {
      "post": {
        "tags": ["Integrations"],
        "summary": "Receives an arbitrary payload and answers a summary",
        "description": "The body content is never echoed: only size, content type, top-level keys (JSON objects) and SHA-256.",
        "requestBody": { "required": true, "content": { "*/*": { "schema": { "type": "string" } } } },
        "responses": {
          "200": { "description": "Reception summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSummary" } } } }
        }
      }
    },
    "/api/v1/graphql": {
      "post": {
        "tags": ["Integrations"],
        "summary": "GraphQL stub (does not execute queries)",
        "description": "Validates the shape and returns a fixed documented response; no real GraphQL parser runs.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GraphqlRequest" } } } },
        "responses": {
          "200": { "description": "Fixed response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GraphqlResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/files/upload": {
      "post": {
        "tags": ["Files"],
        "summary": "Upload analyzed in memory",
        "description": "Accepts multipart/form-data (part \"file\") or application/octet-stream (with ?name=). Nothing is written to disk; the name is sanitized.",
        "parameters": [{ "name": "name", "in": "query", "schema": { "type": "string" }, "description": "File name (required only for octet-stream)" }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": { "file": { "type": "string", "format": "binary" } }
              }
            },
            "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
          }
        },
        "responses": {
          "201": { "description": "Upload summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Upload" } } } },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/static/{name}": {
      "get": {
        "tags": ["Files"],
        "summary": "Static file from the allowlist",
        "description": "Allowed: robots.txt, style.css, logo.svg, data.csv. Segments with backslash, slash or NUL get 400 (path_traversal_rejected); dot segments are normalized by the URL parser and never reach the allowlist.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Fixed content with the matching Content-Type", "content": { "text/plain": {}, "text/css": {}, "image/svg+xml": {}, "text/csv": {} } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/status": {
      "get": {
        "tags": ["Admin"],
        "summary": "Non-sensitive counters",
        "responses": {
          "200": { "description": "Operational status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminStatus" } } } }
        }
      }
    },
    "/admin/config": {
      "post": {
        "tags": ["Admin"],
        "summary": "Validates and echoes configuration (does not apply)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Validated echo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminConfig" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/internal/debug": {
      "get": {
        "tags": ["Admin"],
        "summary": "Non-sensitive debugging data",
        "responses": {
          "200": { "description": "Versions, uptime and counters", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Debug" } } } }
        }
      }
    },
    "/lab/echo": {
      "get": {
        "tags": ["Lab"],
        "summary": "Request echo (header allowlist)",
        "description": "Reflects method, path, raw query and the allowlist headers (Host, User-Agent, Accept, Accept-Encoding, Accept-Language, Content-Type, Content-Length, X-Request-ID, X-Test-Case, X-Forwarded-For, X-Forwarded-Proto). Authorization and Cookie are never reflected; the body is summarized as size + SHA-256.",
        "responses": {
          "200": { "description": "Echo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Echo" } } } }
        }
      }
    },
    "/lab/method": {
      "get": {
        "tags": ["Lab"],
        "summary": "Reports the received method",
        "responses": {
          "200": { "description": "Method and list of accepted methods", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Method" } } } }
        }
      },
      "head": {
        "tags": ["Lab"],
        "summary": "HEAD of the method utility",
        "responses": { "200": { "description": "Headers only (Content-Length of the equivalent body)" } }
      },
      "post": { "tags": ["Lab"], "summary": "POST on the method utility", "responses": { "200": { "description": "Method POST", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Method" } } } } } },
      "put": { "tags": ["Lab"], "summary": "PUT on the method utility", "responses": { "200": { "description": "Method PUT", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Method" } } } } } },
      "patch": { "tags": ["Lab"], "summary": "PATCH on the method utility", "responses": { "200": { "description": "Method PATCH", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Method" } } } } } },
      "delete": { "tags": ["Lab"], "summary": "DELETE on the method utility", "responses": { "200": { "description": "Method DELETE", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Method" } } } } } },
      "options": { "tags": ["Lab"], "summary": "OPTIONS on the method utility", "responses": { "200": { "description": "Method OPTIONS and the full Allow header", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Method" } } } } } }
    },
    "/lab/slow": {
      "get": {
        "tags": ["Lab"],
        "summary": "Configurable delay",
        "parameters": [{ "name": "ms", "in": "query", "schema": { "type": "integer", "minimum": 0, "maximum": 10000 }, "description": "Milliseconds to wait (0 up to MAX_SLOW_MS, default 10000)" }],
        "responses": {
          "200": { "description": "Wait completed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Slow" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/lab/status/{code}": {
      "get": {
        "tags": ["Lab"],
        "summary": "Answers with the requested status",
        "description": "Accepts 200..599; 204, 205 and 304 come without a body.",
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 200, "maximum": 599 } }],
        "responses": {
          "200": { "description": "Requested status (the actual code is the requested one)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusBody" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/lab/response-marker": {
      "get": {
        "tags": ["Lab"],
        "summary": "Fixed response marker",
        "description": "text/plain body with LAB_RESPONSE_MARKER_7f3a and an X-Lab-Marker header with the same value.",
        "responses": {
          "200": { "description": "Marker", "content": { "text/plain": { "schema": { "type": "string", "example": "LAB_RESPONSE_MARKER_7f3a\n" } } } }
        }
      }
    },
    "/lab/large": {
      "get": {
        "tags": ["Lab"],
        "summary": "N-byte body",
        "parameters": [{ "name": "bytes", "in": "query", "schema": { "type": "integer", "minimum": 0, "maximum": 1048576 }, "description": "Exact body size (0 up to MAX_LARGE_BYTES)" }],
        "responses": {
          "200": { "description": "N bytes of A", "content": { "text/plain": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/lab/headers": {
      "get": {
        "tags": ["Lab"],
        "summary": "Fixed set of security headers",
        "responses": {
          "200": { "description": "List of the fixed headers", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Headers" } } } }
        }
      }
    },
    "/lab/stream": {
      "get": {
        "tags": ["Lab"],
        "summary": "Response in parts (chunked)",
        "description": "Five parts lab-stream-chunk-N-of-5 sent every 100 ms with Transfer-Encoding: chunked.",
        "responses": {
          "200": { "description": "Stream in parts", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/lab/calls": {
      "get": {
        "tags": ["Lab"],
        "summary": "Buffer of the last received requests",
        "description": "Protection: X-Lab-Token header or Authorization: Bearer with the LAB_ADMIN_TOKEN value. Without the env set, answers 404 (lab_calls_disabled). This is the proof of what actually reached the process.",
        "responses": {
          "200": { "description": "Recorded calls (chronological)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Calls" } } } },
          "401": { "description": "Missing token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Invalid token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Endpoints disabled (LAB_ADMIN_TOKEN not set)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/lab/calls/reset": {
      "post": {
        "tags": ["Lab"],
        "summary": "Clears the calls buffer",
        "responses": {
          "200": { "description": "Buffer cleared", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallsReset" } } } },
          "401": { "description": "Missing token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Invalid token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Endpoint disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "UserId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "BearerAuth": { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string", "example": "Bearer vhl-..." }, "description": "Synthetic token obtained at /api/v1/auth/login" }
    },
    "responses": {
      "BadRequest": { "description": "Invalid syntax (broken JSON, non-numeric id, invalid query)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Resource or route does not exist", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "UnsupportedMediaType": { "description": "Unexpected Content-Type for the endpoint", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ValidationError": { "description": "Valid body but semantically invalid (missing or out-of-range fields)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "request_id"],
            "properties": {
              "code": { "type": "string", "example": "validation_error" },
              "message": { "type": "string", "example": "\"rating\" must be between 1 and 5, got 9" },
              "request_id": { "type": "string", "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6" }
            }
          }
        }
      },
      "Index": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "v-http-apilab" },
          "version": { "type": "string", "example": "1.0.1" },
          "description": { "type": "string" },
          "endpoints": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Health": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } },
      "Ready": { "type": "object", "properties": { "status": { "type": "string", "example": "ready" } } },
      "Version": {
        "type": "object",
        "properties": {
          "app": { "type": "string", "example": "v-http-apilab" },
          "version": { "type": "string", "example": "1.0.1" },
          "v_version": { "type": "string", "example": "V 0.5.2 c6bb06f" },
          "build_date": { "type": "string", "example": "2026-10-10" },
          "deterministic_seed": { "type": "boolean", "example": true }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string", "example": "lab-password-123456" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "vhl-3fa85f64-5717-4562-b3fc-2c963f66afa6" },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "integer", "example": 3600 },
          "username": { "type": "string", "example": "admin" },
          "request_id": { "type": "string" }
        }
      },
      "Logout": { "type": "object", "properties": { "logged_out": { "type": "boolean" }, "request_id": { "type": "string" } } },
      "Me": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "display_name": { "type": "string", "example": "Lab Administrator (synthetic)" },
          "role": { "type": "string", "example": "admin" },
          "email": { "type": "string", "example": "admin@lab.example" },
          "request_id": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 7 },
          "name": { "type": "string", "example": "Lab User 7" },
          "email": { "type": "string", "example": "user7@lab.example" },
          "department": { "type": "string", "example": "finance" },
          "role": { "type": "string", "enum": ["admin", "operator", "viewer"] }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["name", "email", "department", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "email": { "type": "string", "maxLength": 254, "description": "user@domain.tld syntax" },
          "department": { "type": "string", "minLength": 1, "maxLength": 50 },
          "role": { "type": "string", "enum": ["admin", "operator", "viewer"] }
        }
      },
      "UserPatch": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "email": { "type": "string", "maxLength": 254 },
          "department": { "type": "string", "minLength": 1, "maxLength": 50 },
          "role": { "type": "string", "enum": ["admin", "operator", "viewer"] }
        }
      },
      "UsersPage": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer", "example": 25 },
          "total_pages": { "type": "integer" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
        }
      },
      "Search": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "integer" },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["user", "report", "document"] },
                "id": { "type": "string" },
                "title": { "type": "string" }
              }
            }
          }
        }
      },
      "ReportsPage": {
        "type": "object",
        "properties": {
          "count": { "type": "integer", "example": 6 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "report_id": { "type": "string", "example": "rep-003" },
                "title": { "type": "string" },
                "category": { "type": "string" },
                "rows": { "type": "integer" },
                "generated_at": { "type": "string", "example": "2026-02-05T00:00:00Z" }
              }
            }
          }
        }
      },
      "ExportRequest": {
        "type": "object",
        "required": ["report_id", "format"],
        "properties": {
          "report_id": { "type": "string", "example": "rep-001" },
          "format": { "type": "string", "enum": ["csv", "json"] }
        }
      },
      "ExportJob": {
        "type": "object",
        "properties": {
          "job_id": { "type": "string", "example": "job-1" },
          "status": { "type": "string", "example": "queued" },
          "report_id": { "type": "string" },
          "format": { "type": "string" },
          "request_id": { "type": "string" }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "TicketInput": {
        "type": "object",
        "required": ["title", "severity"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 2000 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "tags": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } }
        }
      },
      "Feedback": {
        "type": "object",
        "properties": {
          "received": { "type": "boolean" },
          "name": { "type": "string" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string" },
          "email": { "type": "string" },
          "request_id": { "type": "string" }
        }
      },
      "WebhookSummary": {
        "type": "object",
        "properties": {
          "received_bytes": { "type": "integer" },
          "content_type": { "type": "string" },
          "json_valid": { "type": "boolean" },
          "top_level_keys": { "type": "array", "items": { "type": "string" } },
          "body_sha256": { "type": "string", "description": "SHA-256 of the body in hex" },
          "stored": { "type": "boolean", "example": false },
          "request_id": { "type": "string" }
        }
      },
      "GraphqlRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "variables": { "type": "object", "maxProperties": 64, "additionalProperties": true }
        }
      },
      "GraphqlResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "object", "additionalProperties": true },
          "errors": { "type": "array", "items": { "type": "string" } },
          "extensions": {
            "type": "object",
            "properties": {
              "query_length": { "type": "integer" },
              "variables_count": { "type": "integer" },
              "variables_keys": { "type": "array", "items": { "type": "string" } },
              "request_id": { "type": "string" }
            }
          }
        }
      },
      "Upload": {
        "type": "object",
        "properties": {
          "filename": { "type": "string", "example": "report.pdf", "description": "Sanitized name (basename, only [A-Za-z0-9._-])" },
          "size": { "type": "integer" },
          "content_type": { "type": "string" },
          "sha256": { "type": "string" },
          "stored": { "type": "boolean", "example": false },
          "request_id": { "type": "string" }
        }
      },
      "AdminStatus": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "example": "lab" },
          "uptime_seconds": { "type": "integer" },
          "requests_total": { "type": "integer" },
          "users": { "type": "integer" },
          "tickets": { "type": "integer" },
          "sessions": { "type": "integer" },
          "export_jobs": { "type": "integer" }
        }
      },
      "AdminConfig": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean" },
          "applied": { "type": "boolean", "example": false },
          "received": { "type": "object", "additionalProperties": true },
          "note": { "type": "string" },
          "request_id": { "type": "string" }
        }
      },
      "Debug": {
        "type": "object",
        "properties": {
          "app": { "type": "string" },
          "version": { "type": "string" },
          "v_version": { "type": "string" },
          "build_date": { "type": "string" },
          "started_at": { "type": "string" },
          "uptime_seconds": { "type": "integer" },
          "counters": { "type": "object", "additionalProperties": { "type": "integer" } }
        }
      },
      "Echo": {
        "type": "object",
        "properties": {
          "method": { "type": "string" },
          "path": { "type": "string" },
          "query": { "type": "string" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "body_bytes": { "type": "integer" },
          "body_sha256": { "type": "string" },
          "request_id": { "type": "string" }
        }
      },
      "Method": {
        "type": "object",
        "properties": {
          "method": { "type": "string" },
          "received": { "type": "boolean" },
          "allowed": { "type": "array", "items": { "type": "string" } },
          "request_id": { "type": "string" }
        }
      },
      "Slow": {
        "type": "object",
        "properties": {
          "slept_ms": { "type": "integer" },
          "max_ms": { "type": "integer" },
          "request_id": { "type": "string" }
        }
      },
      "StatusBody": {
        "type": "object",
        "properties": {
          "requested_status": { "type": "integer" },
          "request_id": { "type": "string" }
        }
      },
      "Headers": {
        "type": "object",
        "properties": {
          "headers_set": { "type": "array", "items": { "type": "string" } },
          "request_id": { "type": "string" }
        }
      },
      "CallRecord": {
        "type": "object",
        "properties": {
          "request_id": { "type": "string" },
          "x_test_case": { "type": "string", "description": "Value of the received X-Test-Case header" },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "route": { "type": "string", "example": "/api/v1/users/:id" },
          "status": { "type": "integer" },
          "timestamp": { "type": "string", "example": "2026-10-10T01:57:19.117Z" }
        }
      },
      "Calls": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "capacity": { "type": "integer", "example": 200 },
          "calls": { "type": "array", "items": { "$ref": "#/components/schemas/CallRecord" } }
        }
      },
      "CallsReset": {
        "type": "object",
        "properties": {
          "reset": { "type": "boolean" },
          "dropped": { "type": "integer" },
          "request_id": { "type": "string" }
        }
      }
    }
  }
}
